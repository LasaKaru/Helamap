{
  "name": "facilityflow",
  "private": true,
  "version": "2.0.0",
  "description": "FacilityFlow — Interactive Facility Map & Wayfinding CMS. Static-first with optional Node/SQLite backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "start:backend": "npm --prefix server run dev",
    "start:full": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm --prefix server run dev\"",
    "build:backend": "npm --prefix server run build",
    "seed:backend": "npm --prefix server run seed"
  },
  "dependencies": {
    "@tiptap/react": "^3.27.4",
    "@tiptap/starter-kit": "^3.27.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.9",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.27.0",
    "react-zoom-pan-pinch": "^3.6.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
