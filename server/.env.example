# ── FacilityFlow backend configuration ──────────────────────────────
# Copy this file to .env and adjust the values.

# Port the API listens on
PORT=4000

# Comma-separated origins allowed by CORS (your frontend URL)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# SQLite database file (created automatically)
DATABASE_PATH=./data/facilityflow.db

# ⚠️ CHANGE BOTH SECRETS BEFORE GOING TO PRODUCTION ⚠️
# Use long random strings, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Initial super admin (created on first start if no users exist)
SEED_ADMIN_EMAIL=admin@facilityflow.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
